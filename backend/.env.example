# Supabase PostgreSQL (Project Settings > Database > Connection string)
# Pooled connection (port 6543, used by the app)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432, used by prisma migrate)
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Firebase Admin (path to the service account JSON, kept OUT of git)
GOOGLE_APPLICATION_CREDENTIALS="./serviceAccountKey.json"

# Allowed frontend origin (Firebase Hosting URL in production)
CORS_ORIGIN="http://localhost:5500"

PORT=3000
